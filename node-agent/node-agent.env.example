# MOONKATTY NODE config — chmod 600. Обычно этот файл ПЕРЕЗАПИСЫВАЕТСЯ при подключении по одноразовому коду (http://127.0.0.1:8791).
# Токен узла хранится ТОЛЬКО в Связке ключей (кладётся туда при подключении). В этот файл токен не записывать.
NODE_ID=imac
NODE_PROFILE=news
# Единственный поддерживаемый режим: прямое HTTPS-подключение к адресу Tailscale Mac mini (100.x) с ЗАКРЕПЛЁННЫМ сертификатом.
# Tailscale Serve и Funnel для узлов не используются и не нужны. Порт Node API — из панели «Компьютеры» (test 8690, prod 8790).
NODE_TLS_MODE=pinned
COORDINATOR_URL=https://100.x.y.z:8690
COORDINATOR_CERT=/Users/YOURUSER/.moonkatty-node/coordinator.crt
COORDINATOR_FINGERPRINT=
NODE_STATUS_PORT=8791
# Лимиты памяти (по умолчанию из профиля: soft 260 MB, hard 384 MB). Heavy AI/Blender НЕ включаются никакими переменными.
# NODE_SOFT_RSS_MB=260
# NODE_MAX_RSS_MB=384
