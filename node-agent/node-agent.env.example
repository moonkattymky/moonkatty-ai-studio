# MOONKATTY NODE config — chmod 600. Token preferably in Keychain (never in this file in plaintext if possible):
#   security add-generic-password -s moonkatty-node-<NODE_ID> -a node-token -w   (вставьте токен при запросе)
NODE_ID=imac
NODE_PROFILE=news
# Вариант A (рекомендуется): Mac mini за `tailscale serve` (TLS-сертификат *.ts.net, только внутри tailnet, БЕЗ funnel)
NODE_TLS_MODE=tailscale
COORDINATOR_URL=https://mac-mini.YOUR-TAILNET.ts.net:8443
# Вариант B: закреплённый самоподписанный сертификат координатора (LAN/Tailscale IP 100.x)
# NODE_TLS_MODE=pinned
# COORDINATOR_URL=https://100.101.102.103:8790
# COORDINATOR_CERT=/Users/YOURUSER/.moonkatty-node/coordinator.crt
# COORDINATOR_FINGERPRINT=
# NODE_TOKEN=   (только если не используете Keychain)
NODE_STATUS_PORT=8791
# Лимиты памяти (по умолчанию из профиля: soft 260 MB, hard 384 MB). Heavy AI/Blender НЕ включаются никакими переменными.
# NODE_SOFT_RSS_MB=260
# NODE_MAX_RSS_MB=384
