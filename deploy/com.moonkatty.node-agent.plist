<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MOONKATTY NODE (iMac NEWS NODE / MacBook MONITOR NODE). USER LaunchAgent (~/Library/LaunchAgents), never root / LaunchDaemons.
     install.sh --autostart substitutes YOURUSER and paths, then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.moonkatty.node-agent.plist
     The agent opens NO network ports: it only connects out to the Mac mini (HTTPS to the Tailscale address 100.x with a pinned certificate; no Serve/Funnel).
     Memory: V8 heap capped at 192 MB; agent exits 75 if RSS stays above the soft limit (260 MB) or crosses 384 MB → KeepAlive restarts it.
     Exit 0 (coordinator command "stop") is NOT restarted. ThrottleInterval 30 s prevents restart loops. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.moonkatty.node-agent</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/node</string>
    <string>--max-old-space-size=192</string>
    <string>--expose-gc</string>
    <string>/Users/YOURUSER/moonkatty-node/agent.js</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>NODE_AGENT_ENV</key><string>/Users/YOURUSER/.moonkatty-node/node-agent.env</string>
    <key>NODE_PROFILE</key><string>news</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/YOURUSER/.moonkatty-node</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/><key>Crashed</key><true/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>20</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Users/YOURUSER/.moonkatty-node/logs/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/YOURUSER/.moonkatty-node/logs/agent.err.log</string>
</dict></plist>
