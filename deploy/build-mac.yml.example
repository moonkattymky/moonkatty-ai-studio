# GitHub Actions: native Apple Silicon build of MOONKATTY AI STUDIO.app (unsigned / ad-hoc) + optional pre-release upload.
# NOT active: our token has no `workflow` permission. To enable, copy to .github/workflows/build-mac.yml either
#  (a) via the GitHub web UI (Add file → Create new file), or
#  (b) with a fine-grained PAT limited to Repository = moonkattymky/moonkatty-ai-studio,
#      Permissions: Contents = Read and write, Workflows = Read and write (nothing else, short expiry).
# Actions are pinned to full commit SHAs (resolved 2026-10-20).
name: build-mac
on:
  workflow_dispatch:
  push:
    tags: ['v*-mac*']
permissions:
  contents: read          # default for all jobs
jobs:
  build:
    runs-on: macos-14     # Apple Silicon (arm64)
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with: { persist-credentials: false }
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with: { node-version: '24.22.0' }
      - run: ./scripts/build-mac.sh
      - name: Smoke: bundled server starts and answers /api/health
        run: |
          R="dist/mac-arm64/MOONKATTY AI STUDIO.app/Contents/Resources"
          STUDIO_DATA_DIR="$RUNNER_TEMP/mk" PORT=8799 "$R/node/node" "$R/app.asar.unpacked/server.js" &
          for i in $(seq 1 20); do curl -sf http://127.0.0.1:8799/api/health && break; sleep 1; done
          codesign --verify --deep --strict --verbose=2 "dist/mac-arm64/MOONKATTY AI STUDIO.app"
          npx --yes @electron/fuses read --app "dist/mac-arm64/MOONKATTY AI STUDIO.app"
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: mac-arm64
          path: |
            dist/*.zip
            dist/*.dmg
            dist/*.sha256
            dist/BUILD-INFO.txt
            dist/sbom.cdx.json
  release:
    if: startsWith(github.ref, 'refs/tags/')
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write     # only this job may create/upload the release
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with: { name: mac-arm64, path: dist }
      - env: { GH_TOKEN: "${{ github.token }}", TAG: "${{ github.ref_name }}" }
        run: |
          gh release view "$TAG" -R "$GITHUB_REPOSITORY" >/dev/null 2>&1 || gh release create "$TAG" -R "$GITHUB_REPOSITORY" --prerelease --title "$TAG" --notes-file dist/BUILD-INFO.txt
          gh release upload "$TAG" -R "$GITHUB_REPOSITORY" dist/* --clobber
