{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonkatty/platforms/read-api.schema.json",
  "title": "Platform Read API v1.0.0 payloads",
  "version": "1.0.0",
  "$defs": {
    "dataMode": { "enum": ["mock", "real", "static-docs"] },
    "money": { "type": "object", "additionalProperties": { "type": "number" } },
    "platform": { "type": "object", "required": ["id", "kind", "label", "formats", "scheduling", "implemented", "dataMode"],
      "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "label": { "type": "string" }, "formats": { "type": "array", "items": { "type": "string" } }, "scheduling": { "enum": ["native", "own"] }, "implemented": { "type": "boolean" }, "dataMode": { "$ref": "#/$defs/dataMode" } } },
    "status": { "type": "object", "required": ["platformId", "dataMode", "mode", "liveGate", "connected", "postCounts", "asOf"],
      "properties": { "platformId": { "type": "string" }, "dataMode": { "$ref": "#/$defs/dataMode" }, "mode": { "enum": ["LIVE", "DRY-RUN"] }, "connected": { "type": ["boolean", "null"] },
        "liveGate": { "type": "object", "required": ["live", "reason"], "properties": { "live": { "type": "boolean" }, "reason": { "type": "string" } } },
        "postCounts": { "type": "object", "additionalProperties": { "type": "integer" } }, "asOf": { "type": "string" } } },
    "pipeline": { "type": "object", "required": ["platformId", "dataMode", "items"],
      "properties": { "platformId": { "type": "string" }, "dataMode": { "$ref": "#/$defs/dataMode" },
        "items": { "type": "array", "items": { "type": "object", "required": ["postId", "contentId", "status", "reviewStatus"],
          "properties": { "postId": { "type": "string" }, "contentId": { "type": "string" }, "status": { "enum": ["queued", "retry_wait", "publishing", "published", "dry_run", "failed", "needs_check", "scheduled", "deferred_quota"] }, "reviewStatus": { "type": ["string", "null"] } } } } } },
    "analytics": { "type": "object", "required": ["platformId", "dataMode", "range", "totals", "unavailable"],
      "properties": { "platformId": { "type": "string" }, "dataMode": { "$ref": "#/$defs/dataMode" }, "range": { "type": "object", "required": ["since", "until"] },
        "totals": { "type": ["object", "null"], "properties": { "views": { "type": ["number", "null"] }, "likes": { "type": ["number", "null"] }, "comments": { "type": ["number", "null"] }, "shares": { "type": ["number", "null"] }, "reach": { "type": ["number", "null"] }, "followers": { "type": ["number", "null"] } } },
        "unavailable": { "type": "array", "items": { "type": "string" } } } },
    "revenueEntry": { "type": "object", "required": ["platform", "amount", "currency", "status", "source", "payoutId"],
      "properties": { "amount": { "type": "number" }, "currency": { "type": "string" }, "status": { "enum": ["estimated", "confirmed"] }, "source": { "type": "string" }, "payoutId": { "type": ["string", "null"] } } },
    "revenue": { "type": "object", "required": ["platformId", "dataMode", "confirmed", "unconfirmed", "viewsAreRevenue"],
      "properties": { "platformId": { "type": "string" }, "dataMode": { "$ref": "#/$defs/dataMode" }, "viewsAreRevenue": { "const": false },
        "confirmed": { "type": "object", "required": ["totals", "entries"], "properties": { "totals": { "$ref": "#/$defs/money" }, "entries": { "type": "array", "items": { "$ref": "#/$defs/revenueEntry" } } } },
        "unconfirmed": { "type": "object", "required": ["totals", "entries"], "properties": { "totals": { "$ref": "#/$defs/money" }, "entries": { "type": "array", "items": { "$ref": "#/$defs/revenueEntry" } } } } } },
    "capabilities": { "type": "object", "required": ["platformId", "accountRequirement", "capabilities", "notAvailable"],
      "properties": { "capabilities": { "type": "array", "items": { "type": "object", "required": ["id", "available", "endpoint"], "properties": { "id": { "type": "string" }, "available": { "type": "boolean" }, "endpoint": { "type": ["string", "null"] } } } } } },
    "snapshot": { "type": "object", "required": ["schemaVersion", "readApiVersion", "generatedAt", "platforms"],
      "properties": { "schemaVersion": { "const": "1.0.0" }, "readApiVersion": { "type": "string" }, "generatedAt": { "type": "string" }, "note": { "type": "string" },
        "platforms": { "type": "object", "additionalProperties": { "type": "object", "required": ["dataMode", "status", "pipeline", "analytics", "revenue"],
          "properties": { "dataMode": { "$ref": "#/$defs/dataMode" }, "status": { "$ref": "#/$defs/status" }, "pipeline": { "$ref": "#/$defs/pipeline" }, "analytics": { "$ref": "#/$defs/analytics" }, "revenue": { "$ref": "#/$defs/revenue" } } } } } }
  }
}
