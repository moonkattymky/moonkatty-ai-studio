{
  "name": "moonkatty-ai-studio",
  "version": "1.3.1-test",
  "description": "MOONKATTY AI STUDIO — control panel (web + macOS desktop)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "NODE_ENV=test STUDIO_FLAVOR=${STUDIO_FLAVOR:-test} node server.js",
    "smoke": "node scripts/smoke.mjs",
    "test:security": "node scripts/security-test.mjs",
    "test:runner": "node scripts/runner-test.mjs",
    "test:opencode": "node scripts/opencode-auth-test.mjs",
    "test:opencode-serve": "node scripts/opencode-serve-test.mjs",
    "test:opencode-json": "node scripts/opencode-json-test.mjs",
    "desktop": "electron .",
    "dist:mac": "echo 'Сборка только через FLAVOR=test|prod scripts/package-mac-on-linux.sh или scripts/build-mac.sh (flavor вшивается)' >&2 && exit 1",
    "test:policy": "node scripts/policy-test.mjs",
    "test:3d": "node scripts/design3d-test.mjs",
    "test:3c": "node scripts/studio3c-test.mjs",
    "test:video": "node scripts/video-render-test.mjs && node scripts/video-render-wiring-test.mjs",
    "test:publish-guard": "node scripts/publish-guard-test.mjs",
    "test:isolation": "node scripts/isolation-test.mjs",
    "test:e2e-test-build": "node scripts/e2e-test-build.mjs",
    "test:nodes": "node scripts/nodes-test.mjs",
    "test:world": "node scripts/world-class-test.mjs",
    "test:ops": "node --test --test-concurrency=1 test/ops/*.test.js",
    "test:ops:studio": "COORD_HELPER=studio node --test test/ops/nodes.multiprocess.test.js",
    "test:update-center": "node --test --test-concurrency=1 test/ops/release-keys.test.js test/ops/update-center.test.js test/ops/update.test.js test/ops/update-center.integration.test.js",
    "test:memory": "node scripts/host-memory-test.mjs",
    "test:diagnose": "node scripts/mac-diagnose-test.mjs",
    "test:location": "node scripts/location-check-test.mjs",
    "test:newsvideo": "node scripts/newsvideo-test.mjs",
    "test:newsvideo-security": "node scripts/newsvideo-security-test.mjs",
    "test:newsvideo-e2e": "node scripts/newsvideo-ui-e2e.mjs",
    "test:video-deps": "node scripts/video-deps-test.mjs",
    "test:subtitle-mindur": "node scripts/subtitle-mindur-test.mjs"
  },
  "keywords": [],
  "author": "MOONKATTY",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "private": true,
  "productName": "MOONKATTY AI STUDIO",
  "optionalDependencies": {
    "better-sqlite3": "11.10.0"
  },
  "build": {
    "appId": "com.moonkatty.aistudio",
    "productName": "MOONKATTY AI STUDIO",
    "copyright": "MOONKATTY",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "meta.js",
      "runner.js",
      "lib/**",
      "blender/**",
      "opencode/**",
      "public/**",
      "desktop/**",
      "config/WORLD_CLASS_MISSION.md",
      "config/mission.yaml",
      "node-agent/**",
      "studio-intelligence/src/**",
      "media-automation/src/jobs/**",
      "media-automation/src/video/**",
      "media-automation/src/host3d/**",
      "media-automation/src/anchor/**",
      "media-automation/src/media/**",
      "media-automation/src/news/**",
      "media-automation/src/orchestrator/facts.js",
      "media-automation/src/store.js",
      "media-automation/src/experimental.js",
      "media-automation/src/platforms/read-api.js",
      "media-automation/src/platforms/registry.js",
      "media-automation/src/platforms/capabilities.js",
      "media-automation/fixtures/platforms-snapshot.sample.json",
      "media-automation/config/**",
      "!media-automation/config/experimental.json",
      "studio-intelligence/contracts/**",
      "media-automation/assets/**",
      "media-automation/tools/**",
      "build/icon.png",
      "!build/node/**",
      "!node_modules/better-sqlite3/**",
      "!node_modules/bindings/**",
      "!node_modules/prebuild-install/**",
      "!node_modules/file-uri-to-path/**",
      "!**/*.map",
      "!**/*.key",
      "!**/*.p8",
      "!**/*.p12",
      "!**/*.pfx",
      "!**/*.priv",
      "!**/*.priv.pem",
      "!**/*private*.pem",
      "!**/*secret*.pem"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.productivity",
        "CFBundleDevelopmentRegion": "ru",
        "NSHumanReadableCopyright": "MOONKATTY"
      }
    },
    "dmg": {
      "title": "MOONKATTY AI STUDIO ${version}"
    },
    "publish": null,
    "asarUnpack": [
      "server.js",
      "meta.js",
      "runner.js",
      "package.json",
      "lib/**",
      "public/**",
      "node_modules/**",
      "blender/**",
      "opencode/**",
      "config/WORLD_CLASS_MISSION.md",
      "config/mission.yaml",
      "node-agent/**",
      "studio-intelligence/src/**",
      "media-automation/src/jobs/**",
      "media-automation/src/video/**",
      "media-automation/src/host3d/**",
      "media-automation/src/anchor/**",
      "media-automation/src/media/**",
      "media-automation/src/news/**",
      "media-automation/src/orchestrator/facts.js",
      "media-automation/src/store.js",
      "media-automation/src/experimental.js",
      "media-automation/src/platforms/read-api.js",
      "media-automation/src/platforms/registry.js",
      "media-automation/src/platforms/capabilities.js",
      "media-automation/fixtures/platforms-snapshot.sample.json",
      "media-automation/config/**",
      "media-automation/package.json",
      "desktop/build-info.json",
      "studio-intelligence/contracts/**",
      "media-automation/assets/**",
      "media-automation/tools/**"
    ],
    "extraResources": [
      {
        "from": "build/node/darwin-arm64",
        "to": "node",
        "filter": [
          "node",
          "LICENSE"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "electronVersion": "44.9.1"
  }
}
