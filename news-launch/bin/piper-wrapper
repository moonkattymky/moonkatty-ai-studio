#!/bin/sh
# Launches the downloaded Piper binary with its bundled libraries.
# PiperTTS spawns this file directly (no shell interpolation of the script text).
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../models/piper" && pwd)
export LD_LIBRARY_PATH="$ROOT${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$ROOT/piper" "$@"
