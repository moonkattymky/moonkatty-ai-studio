{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/voiceover.json",
  "title": "Voiceover",
  "type": "object",
  "additionalProperties": true,
  "required": ["engine", "license", "commercialUse", "segments"],
  "properties": {
    "engine": { "type": "string" },
    "voice": { "type": "string" },
    "license": { "type": "string" },
    "commercialUse": { "type": "boolean" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "file", "durationSec"],
        "properties": {
          "text": { "type": "string" },
          "file": { "type": "string" },
          "durationSec": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
