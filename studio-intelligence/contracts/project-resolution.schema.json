{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/project-resolution.schema.json",
  "title": "ProjectResolution",
  "description": "Ответ resolveProject. Неизвестный projectId становится unassigned, rawProjectId сохраняется, dropped всегда false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "rawProjectId", "known", "namespace", "slug", "dropped"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1, "maxLength": 140 },
    "rawProjectId": { "type": ["string", "null"], "maxLength": 140 },
    "known": { "type": "boolean" },
    "namespace": { "type": ["string", "null"], "enum": ["moonkatty_news", "moonkatty_project", "moonkatty_shared", null] },
    "slug": { "type": ["string", "null"], "maxLength": 64 },
    "dropped": { "const": false }
  }
}
