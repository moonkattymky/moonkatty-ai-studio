{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/task-handoff.schema.json",
  "title": "TaskHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "idempotencyKey", "namespace", "agentId", "title", "description", "priority", "dependsOn", "executor", "requiresOwnerApproval", "files"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9:._/-]{1,400}$" },
    "namespace": { "enum": ["moonkatty_news", "moonkatty_project", "moonkatty_shared"] },
    "agentId": { "enum": ["director", "news", "video", "social", "pr", "games", "mkty", "analytics", "marketing", "content", "publishing", "community", "design3d"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 8000 },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "dependsOn": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
    },
    "executor": { "enum": ["runtime", "opencode", "human"] },
    "requiresOwnerApproval": { "type": "boolean" },
    "files": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "version"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "role": { "enum": ["input", "output", "reference"] },
          "version": { "type": "integer", "minimum": 1 },
          "mediaType": { "type": "string", "maxLength": 120 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
