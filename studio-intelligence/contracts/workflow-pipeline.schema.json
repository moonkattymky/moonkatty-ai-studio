{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/workflow-pipeline.schema.json",
  "title": "WorkflowPipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "namespace", "title", "steps"],
  "properties": {
    "id": { "enum": ["news", "studio3d", "games"] },
    "namespace": { "enum": ["moonkatty_news", "moonkatty_project", "moonkatty_shared"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agentId", "requiresOwnerApproval", "autoExecute"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "agentId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "requiresOwnerApproval": { "type": "boolean" },
          "autoExecute": { "type": "boolean" },
          "executor": { "enum": ["runtime", "opencode", "human"] }
        }
      }
    }
  }
}
