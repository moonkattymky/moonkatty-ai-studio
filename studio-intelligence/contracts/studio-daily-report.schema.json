{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/studio-daily-report.schema.json",
  "title": "StudioDailyReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "to", "namespaces", "compact", "work", "publications", "errors", "costs", "health", "approvals", "qa", "attention"],
  "properties": {
    "from": { "type": "string", "format": "date-time" },
    "to": { "type": "string", "format": "date-time" },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["moonkatty_news", "moonkatty_project"] }
    },
    "compact": { "type": "boolean" },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "progressEvents"],
      "properties": {
        "tasks": { "type": "integer", "minimum": 0 },
        "progressEvents": { "type": "integer", "minimum": 0 }
      }
    },
    "publications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versions", "usages"],
      "properties": {
        "versions": { "type": "integer", "minimum": 0 },
        "usages": { "type": "integer", "minimum": 0 }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failedProgress", "qaFailed"],
      "properties": {
        "failedProgress": { "type": "integer", "minimum": 0 },
        "qaFailed": { "type": "integer", "minimum": 0 }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "totalUsd", "available"],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "totalUsd": { "type": "number", "minimum": 0 },
        "available": { "type": "boolean" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "components"],
      "properties": {
        "available": { "type": "boolean" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "ok"],
            "properties": {
              "component": { "type": "string", "minLength": 1, "maxLength": 64 },
              "ok": { "type": "boolean" },
              "detail": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "approved", "rejected"],
      "properties": {
        "pending": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed", "passed"],
      "properties": {
        "failed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 }
      }
    },
    "attention": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 500 } }
  }
}
