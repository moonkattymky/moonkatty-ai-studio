{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/memory-record-input.schema.json",
  "title": "MemoryRecordInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "kind", "title", "body", "status", "sourcePath", "sourceRecordId", "idempotencyKey", "payload"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "namespace": { "enum": ["moonkatty_news", "moonkatty_project"] },
    "kind": { "enum": ["decision", "task", "result", "file", "model_version", "publication_version", "document"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "body": { "type": "string", "maxLength": 200000 },
    "status": { "enum": ["draft", "approved", "superseded", "rejected"] },
    "sourcePath": { "type": ["string", "null"], "maxLength": 500 },
    "sourceRecordId": { "type": ["string", "null"], "maxLength": 64 },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9:._/-]{1,400}$" },
    "payload": { "type": "object" }
  }
}
