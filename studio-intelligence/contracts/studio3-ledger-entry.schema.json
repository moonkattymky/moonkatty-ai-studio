{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/studio3-ledger-entry.schema.json",
  "title": "Studio3LedgerEntry",
  "description": "Строка журнала Studio 3 после разбора адаптером. На проводе amount — десятичная строка, date — YYYY-MM-DD, proof — объект или null. Адаптер приводит amount к числу, дату к полуночи UTC и отбрасывает служебные поля журнала.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "direction", "amount", "currency", "date", "source", "proof"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "kind": { "enum": ["actual", "estimate", "forecast"] },
    "direction": { "enum": ["income", "expense"] },
    "amount": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "date": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1, "maxLength": 200 },
    "proof": {
      "type": ["object", "string", "null"]
    },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 140 }
  }
}
