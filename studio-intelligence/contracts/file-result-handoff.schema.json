{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/file-result-handoff.schema.json",
  "title": "FileResultHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "namespace", "idempotencyKey", "files", "result"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "namespace": { "enum": ["moonkatty_news", "moonkatty_project", "moonkatty_shared"] },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9:._/-]{1,400}$" },
    "files": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "version"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "role": { "enum": ["input", "output", "reference"] },
          "version": { "type": "integer", "minimum": 1 },
          "mediaType": { "type": "string", "maxLength": 120 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "status"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "status": { "enum": ["done", "waiting_approval", "failed"] }
      }
    }
  }
}
