{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/cancellation.schema.json",
  "title": "CancellationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "namespace", "requestedBy", "at", "reason"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "namespace": { "enum": ["moonkatty_news", "moonkatty_project"] },
    "requestedBy": { "type": "string", "minLength": 1, "maxLength": 64 },
    "at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
