{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/approval-request.schema.json",
  "title": "ApprovalRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "namespace", "subjectType", "subjectId", "requiredRole", "status", "autoExecute", "requestedBy", "requestedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "namespace": { "enum": ["moonkatty_news", "moonkatty_project"] },
    "subjectType": { "enum": ["task", "publication", "brand_substitution", "workflow_step", "opencode", "asset"] },
    "subjectId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requiredRole": { "const": "owner" },
    "status": { "const": "pending" },
    "autoExecute": { "const": false },
    "requestedBy": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requestedAt": { "type": "string", "format": "date-time" },
    "comment": { "type": "string", "maxLength": 2000 }
  }
}
