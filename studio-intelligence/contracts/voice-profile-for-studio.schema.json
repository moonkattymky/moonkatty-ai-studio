{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkatty.local/schemas/voice-profile-for-studio.schema.json",
  "title": "VoiceProfileForStudio",
  "description": "Профиль, который основная студия читает перед мимикой. Поля совпадают с docs/ROADMAP_3D_CHARACTER.md на feat/v1.2.0. Синтез не вызывается.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "approved", "sampleRate", "recognizer", "gain", "mouthScale"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "approved": { "const": true },
    "sampleRate": { "type": ["integer", "null"], "minimum": 16000, "maximum": 48000 },
    "recognizer": { "type": ["string", "null"], "maxLength": 32 },
    "gain": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "mouthScale": { "type": ["number", "null"], "minimum": 0, "maximum": 4 }
  }
}
